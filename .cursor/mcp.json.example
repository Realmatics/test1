{
  "mcpServers": {
    "sftp-webspace": {
      "command": "node",
      "args": ["/workspace/mcp-server-sftp/index.js"],
      "env": {
        "SFTP_HOST": "YOUR_SFTP_HOST",
        "SFTP_PORT": "22",
        "SFTP_USER": "YOUR_SFTP_USER",
        "SFTP_PASSWORD": "YOUR_SFTP_PASSWORD"
      }
    }
  }
}
